{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Methodology surface review", "type": "object", "required": ["version", "snapshot_id", "status", "included", "excluded", "added"], "additionalProperties": false,
  "properties": {"version": {"const": 1}, "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"const": "confirmed"}, "included": {"$ref": "#/$defs/entities"}, "excluded": {"$ref": "#/$defs/entities"}, "added": {"$ref": "#/$defs/entities"}},
  "$defs": {"entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "entity": {"type": "object", "required": ["entity_type", "canonical_key", "display_name", "attributes", "sources"], "additionalProperties": false, "properties": {"entity_type": {"type": "string", "minLength": 1}, "canonical_key": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}, "attributes": {"type": "object", "additionalProperties": false, "patternProperties": {"^[A-Za-z][A-Za-z0-9_.-]*$": {"type": ["string", "number", "boolean", "array"], "items": {"type": ["string", "number", "boolean"]}}}}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}}, "source": {"type": "object", "required": ["repo_id", "revision", "relative_path", "pointer", "selection_reason", "sha256"], "additionalProperties": false, "properties": {"repo_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}, "pointer": {"type": "string", "minLength": 1}, "selection_reason": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}
