{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded discovery surface decisions",
  "type": "object", "additionalProperties": false,
  "required": ["version", "candidate_id", "accept_all", "include", "exclude", "add", "conflict_resolutions", "duplicate_merges"],
  "properties": {"version": {"const": 1}, "candidate_id": {"type": "string", "pattern": "\\S"}, "accept_all": {"type": "boolean"}, "include": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}, "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}, "add": {"type": "array", "items": {"$ref": "#/$defs/addition"}}, "conflict_resolutions": {"type": "array", "items": {"$ref": "#/$defs/conflict_resolution"}}, "duplicate_merges": {"type": "array", "items": {"$ref": "#/$defs/duplicate_merge"}}},
  "$defs": {"scalar": {"type": ["string", "number", "boolean", "null"]}, "attribute_value": {"oneOf": [{"$ref": "#/$defs/scalar"}, {"type": "array", "items": {"$ref": "#/$defs/scalar"}}]}, "attributes": {"type": "object", "additionalProperties": false, "patternProperties": {"^[A-Za-z][A-Za-z0-9_.-]*$": {"$ref": "#/$defs/attribute_value"}}}, "addition": {"type": "object", "additionalProperties": false, "required": ["entity_type", "canonical_key", "display_name", "attributes"], "properties": {"entity_type": {"enum": ["component", "interface", "integration", "flow"]}, "canonical_key": {"type": "string", "pattern": "\\S"}, "display_name": {"type": "string", "pattern": "\\S"}, "attributes": {"$ref": "#/$defs/attributes"}}}, "conflict_resolution": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "value"], "properties": {"conflict_id": {"type": "string", "pattern": "\\S"}, "value": {"$ref": "#/$defs/attribute_value"}}}, "duplicate_merge": {"type": "object", "additionalProperties": false, "required": ["duplicate_id", "canonical_key"], "properties": {"duplicate_id": {"type": "string", "pattern": "\\S"}, "canonical_key": {"type": "string", "pattern": "\\S"}}}}
}
