{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Methodology template contract", "type": "object", "required": ["version", "sections"], "additionalProperties": false,
  "properties": {"version": {"const": 1}, "sections": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/section"}}},
  "$defs": {"section": {"type": "object", "required": ["id", "heading", "allow_not_applicable", "required_input_targets", "required_literals", "related_question_ids"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "heading": {"type": "string", "minLength": 1}, "allow_not_applicable": {"type": "boolean"}, "required_input_targets": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"}, "uniqueItems": true}, "required_literals": {"type": "array", "items": {"type": "string", "pattern": "^<!-- mnt:construct:[a-z0-9-]+ -->$"}, "uniqueItems": true}, "table_columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "minimum_data_rows": {"type": "integer", "minimum": 1}, "related_question_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"}, "uniqueItems": true}}, "allOf": [{"if": {"required": ["table_columns"]}, "then": {"required": ["minimum_data_rows"]}}]}}}
