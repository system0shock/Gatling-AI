{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Methodology approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "base_sha256",
    "candidate_sha256",
    "patch_sha256",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "enum": ["workspace-manifest", "methodology-patch"] },
    "base_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_sha256": { "$ref": "#/$defs/sha256" },
    "patch_sha256": { "$ref": "#/$defs/sha256" },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
