{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Methodology question catalog", "type": "object", "required": ["version", "questions"], "additionalProperties": false,
  "properties": {"version": {"const": 1}, "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"}, "question": {"type": "object", "required": ["id", "section", "prompt", "target", "type", "required", "applies_to"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "section": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1}, "target": {"$ref": "#/$defs/id"}, "type": {"enum": ["choice", "number", "text", "boolean"]}, "choices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "required": {"type": "boolean"}, "applies_to": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "allOf": [{"if": {"properties": {"type": {"const": "choice"}}}, "then": {"required": ["choices"]}}]}}}
