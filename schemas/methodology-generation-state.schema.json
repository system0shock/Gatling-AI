{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Methodology generation state", "type": "object", "required": ["version", "blocks"], "additionalProperties": false,
  "properties": {"version": {"const": 1}, "blocks": {"type": "object", "additionalProperties": false, "patternProperties": {"^[a-z][a-z0-9-]*$": {"$ref": "#/$defs/block"}}}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "block": {"type": "object", "required": ["sha256", "rendered_sha256", "resolution"], "additionalProperties": false, "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "rendered_sha256": {"$ref": "#/$defs/sha256"}, "resolution": {"enum": ["rendered", "keep"]}}}}
}
