{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Methodology readiness report", "type": "object", "required": ["version", "status", "ready_for_test", "workspace_snapshot_id", "missing"], "additionalProperties": false,
  "properties": {"version": {"const": 1}, "status": {"enum": ["ready", "blocked"]}, "ready_for_test": {"type": "boolean"}, "workspace_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "missing": {"type": "array", "items": {"$ref": "#/$defs/missing"}}},
  "$defs": {"missing": {"type": "object", "required": ["target", "question_id", "message"], "additionalProperties": false, "properties": {"target": {"type": "string", "minLength": 1}, "question_id": {"type": ["string", "null"]}, "message": {"type": "string", "minLength": 1}}}}
}
