{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gatling-AI methodology evidence",
  "type": "object",
  "required": ["version", "producer", "generated_at", "records"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "producer": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time", "minLength": 1},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "entity_type", "entity_id", "section", "field", "statement", "source", "confidence", "freshness"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": "string", "minLength": 1},
        "freshness": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["source_type", "ref"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["repository", "confluence", "manual-confirmation", "monitoring", "openapi", "section-review"]
        },
        "ref": {"type": "string", "minLength": 1},
        "module_id": {"type": ["string", "null"], "minLength": 1},
        "revision": {"type": ["string", "null"], "minLength": 1},
        "page_id": {"type": ["string", "null"], "minLength": 1},
        "page_version": {"type": ["integer", "null"], "minimum": 0},
        "observed_at": {"type": ["string", "null"], "format": "date-time", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"enum": ["repository", "openapi"]}}},
          "then": {
            "required": ["module_id", "revision"],
            "properties": {
              "module_id": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"source_type": {"const": "confluence"}}},
          "then": {
            "required": ["page_id", "page_version"],
            "properties": {
              "page_id": {"type": "string", "minLength": 1},
              "page_version": {"type": "integer", "minimum": 0}
            }
          }

        }
      ]
    }
  }
}
