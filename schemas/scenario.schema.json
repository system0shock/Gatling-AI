{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatling-ai.local/schemas/scenario.schema.json",
  "title": "Gatling-AI Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario"],
  "properties": {
    "lint_waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "reason", "owner", "expires"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source",
        "sut",
        "steps",
        "load",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sut": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_url"],
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feeders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "file", "strategy"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strategy": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "title", "transaction", "protocol", "request", "checks"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "transaction": {
                "type": "string",
                "minLength": 1
              },
              "protocol": {
                "type": "string",
                "enum": ["http"]
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "path"],
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "type": "string"
                  }
                }
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "required": ["status"],
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "required": ["extract"],
                      "properties": {
                        "extract": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["type", "expr", "saveAs"],
                          "properties": {
                            "type": {
                              "type": "string",
                              "minLength": 1
                            },
                            "expr": {
                              "type": "string",
                              "minLength": 1
                            },
                            "saveAs": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "profile", "users", "ramp_seconds", "duration_seconds"],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "users": {
              "type": "integer"
            },
            "ramp_seconds": {
              "type": "integer"
            },
            "duration_seconds": {
              "type": "integer"
            }
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "metric", "op", "value"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
