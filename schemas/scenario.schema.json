{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gatling-ai.local/schemas/scenario.schema.json",
  "title": "Gatling-AI Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario"],
  "$defs": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          {
            "additionalProperties": false,
            "required": ["status"],
            "properties": { "status": { "type": "integer" } }
          },
          {
            "additionalProperties": false,
            "required": ["extract"],
            "properties": {
              "extract": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "expr", "saveAs"],
                "properties": {
                  "type": { "enum": ["css", "jsonPath", "regex"] },
                  "expr": { "type": "string", "minLength": 1 },
                  "saveAs": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url"],
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feeders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "file", "strategy"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "strategy": {
                "enum": ["circular", "queue", "random", "shuffle"]
              },
              "delimiter": {
                "type": "string",
                "minLength": 1
              },
              "ignore_first_line": {
                "type": "boolean"
              },
              "quoted_text": {
                "type": "boolean"
              },
              "share_mode": {
                "enum": ["all", "threads", "group"]
              },
              "recycle": {
                "type": "boolean"
              },
              "random_order": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "var_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "hook": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["ref", "kind", "snippet", "summary"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "kind": { "const": "translated" },
            "snippet": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "reads": { "$ref": "#/$defs/var_names" },
            "writes": { "$ref": "#/$defs/var_names" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["ref", "kind", "summary"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "kind": { "const": "todo" },
            "summary": { "type": "string", "minLength": 1 },
            "reads": { "$ref": "#/$defs/var_names" },
            "writes": { "$ref": "#/$defs/var_names" },
            "hints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": true,
                "properties": {
                  "kind": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "before": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hook" } },
        "after": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hook" } }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          {
            "additionalProperties": false,
            "required": ["name", "title", "transaction", "protocol", "request", "checks"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "transaction": { "type": "string", "minLength": 1 },
              "protocol": { "const": "http" },
              "pause_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "tags": { "$ref": "#/$defs/tags" },
              "hooks": { "$ref": "#/$defs/hooks" },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "path"],
                "not": { "required": ["body", "body_file"] },
                "properties": {
                  "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
                  "path": { "type": "string", "minLength": 1 },
                  "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                  "body": { "type": "string" },
                  "body_file": { "type": "string", "minLength": 1 }
                }
              },
              "checks": { "$ref": "#/$defs/checks" }
            }
          },
          {
            "additionalProperties": false,
            "required": ["name", "title", "transaction", "protocol", "graphql", "checks"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "transaction": { "type": "string", "minLength": 1 },
              "protocol": { "const": "graphql" },
              "pause_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "tags": { "$ref": "#/$defs/tags" },
              "hooks": { "$ref": "#/$defs/hooks" },
              "graphql": {
                "type": "object",
                "additionalProperties": false,
                "required": ["query"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "query": { "type": "string", "minLength": 1 },
                  "variables": { "type": "object" }
                }
              },
              "checks": { "$ref": "#/$defs/checks" }
            }
          },
          {
            "additionalProperties": false,
            "required": ["name", "title", "transaction", "protocol", "kafka"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "transaction": { "type": "string", "minLength": 1 },
              "protocol": { "const": "kafka" },
              "pause_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "tags": { "$ref": "#/$defs/tags" },
              "hooks": { "$ref": "#/$defs/hooks" },
              "kafka": {
                "type": "object",
                "additionalProperties": false,
                "required": ["topic", "payload"],
                "properties": {
                  "topic": { "type": "string", "minLength": 1 },
                  "key": { "type": "string", "minLength": 1 },
                  "payload": { "type": "string", "minLength": 1 },
                  "request_reply": { "type": "boolean" },
                  "reply_topic": { "type": "string", "minLength": 1 },
                  "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "jsonPath": { "type": "string", "minLength": 1 },
                        "is": { "type": "string" }
                      },
                      "required": ["jsonPath", "is"]
                    }
                  }
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "required": ["name", "title", "transaction", "protocol", "jdbc"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "transaction": { "type": "string", "minLength": 1 },
              "protocol": { "const": "jdbc" },
              "pause_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "tags": { "$ref": "#/$defs/tags" },
              "hooks": { "$ref": "#/$defs/hooks" },
              "jdbc": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": { "type": "string", "minLength": 1 },
                  "saveAs": { "type": "string", "minLength": 1 },
                  "action": { "enum": ["insert", "update", "raw_sql", "call"] },
                  "table": { "type": "string", "minLength": 1 },
                  "columns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
                  "values": { "type": "object", "additionalProperties": true },
                  "set": { "type": "object", "additionalProperties": { "type": "string" } },
                  "where": { "type": "string", "minLength": 1 },
                  "sql": { "type": "string", "minLength": 1 },
                  "procedure": { "type": "string", "minLength": 1 },
                  "params": { "type": "object", "additionalProperties": true },
                  "out_params": { "type": "object", "additionalProperties": { "type": "string" } }
                }
              }
            }
          }
        ]
      }
    },
    "load": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["model", "profile", "users", "ramp_seconds", "duration_seconds"],
          "properties": {
            "model": { "const": "closed" },
            "profile": { "const": "ramp" },
            "users": { "type": "integer", "exclusiveMinimum": 0 },
            "ramp_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "users", "duration_seconds"],
          "properties": {
            "model": { "const": "closed" },
            "profile": { "enum": ["constant", "soak"] },
            "users": { "type": "integer", "exclusiveMinimum": 0 },
            "duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "users", "levels", "level_duration_seconds"],
          "properties": {
            "model": { "const": "closed" },
            "profile": { "const": "stress" },
            "users": { "type": "integer", "exclusiveMinimum": 0 },
            "levels": { "type": "integer", "minimum": 2 },
            "level_duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "model", "profile", "users", "baseline_users",
            "baseline_seconds", "spike_rise_seconds", "spike_hold_seconds"
          ],
          "properties": {
            "model": { "const": "closed" },
            "profile": { "const": "spike" },
            "users": { "type": "integer", "exclusiveMinimum": 0 },
            "baseline_users": { "type": "integer", "exclusiveMinimum": 0 },
            "baseline_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "spike_rise_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "spike_hold_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "users_per_second", "ramp_seconds", "duration_seconds"],
          "properties": {
            "model": { "const": "open" },
            "profile": { "const": "ramp" },
            "users_per_second": { "type": "number", "exclusiveMinimum": 0 },
            "ramp_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "users_per_second", "duration_seconds"],
          "properties": {
            "model": { "const": "open" },
            "profile": { "enum": ["constant", "soak"] },
            "users_per_second": { "type": "number", "exclusiveMinimum": 0 },
            "duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "users_per_second", "levels", "level_duration_seconds"],
          "properties": {
            "model": { "const": "open" },
            "profile": { "const": "stress" },
            "users_per_second": { "type": "number", "exclusiveMinimum": 0 },
            "levels": { "type": "integer", "minimum": 2 },
            "level_duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "model", "profile", "users_per_second", "baseline_users_per_second",
            "baseline_seconds", "spike_rise_seconds", "spike_hold_seconds"
          ],
          "properties": {
            "model": { "const": "open" },
            "profile": { "const": "spike" },
            "users_per_second": { "type": "number", "exclusiveMinimum": 0 },
            "baseline_users_per_second": { "type": "number", "exclusiveMinimum": 0 },
            "baseline_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "spike_rise_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "spike_hold_seconds": { "type": "integer", "exclusiveMinimum": 0 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "stages"],
          "properties": {
            "model": { "const": "closed" },
            "profile": { "const": "stages" },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["users", "ramp_seconds", "hold_seconds"],
                "properties": {
                  "users": { "type": "integer", "exclusiveMinimum": 0 },
                  "ramp_seconds": { "type": "integer", "minimum": 0 },
                  "hold_seconds": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["model", "profile", "stages"],
          "properties": {
            "model": { "const": "open" },
            "profile": { "const": "stages" },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["users_per_second", "ramp_seconds", "hold_seconds"],
                "properties": {
                  "users_per_second": { "type": "number", "exclusiveMinimum": 0 },
                  "ramp_seconds": { "type": "integer", "minimum": 0 },
                  "hold_seconds": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "metric", "op", "value"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kafka": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bootstrap_servers"],
          "properties": {
            "bootstrap_servers": { "type": "string", "minLength": 1 },
            "properties": { "type": "object", "additionalProperties": { "type": "string" } },
            "timeout_seconds": { "type": "integer", "exclusiveMinimum": 0 },
            "match_by": { "enum": ["key", "value"] }
          }
        },
        "jdbc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "username", "password"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "maximum_pool_size": { "type": "integer", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  },
  "properties": {
    "lint_waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "reason", "owner", "expires"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["id", "title", "system", "number", "source", "sut", "steps", "load", "assertions"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "system": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
            "number": { "type": "integer", "minimum": 1 },
            "source": { "$ref": "#/$defs/source" },
            "sut": { "$ref": "#/$defs/sut" },
            "data": { "$ref": "#/$defs/data" },
            "protocols": { "$ref": "#/$defs/protocols" },
            "steps": { "$ref": "#/$defs/steps" },
            "load": { "$ref": "#/$defs/load" },
            "assertions": { "$ref": "#/$defs/assertions" },
            "lifecycle": { "enum": ["managed", "detached"] }
          }
        },
        {
          "additionalProperties": false,
          "required": ["id", "title", "system", "number", "source", "sut", "populations", "assertions"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "system": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
            "number": { "type": "integer", "minimum": 1 },
            "source": { "$ref": "#/$defs/source" },
            "sut": { "$ref": "#/$defs/sut" },
            "data": { "$ref": "#/$defs/data" },
            "protocols": { "$ref": "#/$defs/protocols" },
            "populations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "steps", "load"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "steps": { "$ref": "#/$defs/steps" },
                  "load": { "$ref": "#/$defs/load" },
                  "start_after_seconds": { "type": "integer", "exclusiveMinimum": 0 }
                }
              }
            },
            "assertions": { "$ref": "#/$defs/assertions" },
            "lifecycle": { "enum": ["managed", "detached"] }
          }
        }
      ]
    }
  }
}
