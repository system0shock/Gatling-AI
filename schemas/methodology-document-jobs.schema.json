{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded document extraction jobs",
  "type": "object", "additionalProperties": false,
  "required": ["version", "repo_id", "snapshot_identity", "jobs"],
  "properties": {"version": {"const": 1}, "repo_id": {"$ref": "#/$defs/nonblank"}, "snapshot_identity": {"$ref": "#/$defs/nonblank"}, "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}}},
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_posix_path": {"type": "string", "pattern": "^(?!.*\\u0000)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^/]+(?:/[^/]+)*$"},
    "job": {"type": "object", "additionalProperties": false, "required": ["source_path", "materialized_path", "allowed_fact_types", "candidate_output_path", "final_output_path", "size_bytes", "sha256", "selection_reason"], "properties": {"source_path": {"$ref": "#/$defs/relative_posix_path"}, "materialized_path": {"$ref": "#/$defs/relative_posix_path"}, "allowed_fact_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["component", "interface", "integration", "flow"]}}, "candidate_output_path": {"$ref": "#/$defs/relative_posix_path"}, "final_output_path": {"$ref": "#/$defs/relative_posix_path"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "selection_reason": {"$ref": "#/$defs/nonblank"}}}
  }
}
