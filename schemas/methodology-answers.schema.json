{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Methodology answers", "type": "object", "required": ["version", "profile", "questions", "not_applicable_sections"], "additionalProperties": false,
  "properties": {"version": {"const": 1}, "profile": {"$ref": "#/$defs/profile"}, "questions": {"$ref": "#/$defs/value_map"}, "not_applicable_sections": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true}},
  "$defs": {"scalar": {"type": ["string", "number", "boolean"]}, "entry": {"type": "object", "required": ["value"], "additionalProperties": false, "properties": {"value": {"$ref": "#/$defs/scalar"}, "sources": {"type": "array", "items": {"type": "string", "minLength": 1}}}}, "value_map": {"type": "object", "additionalProperties": false, "patternProperties": {"^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$": {"$ref": "#/$defs/entry"}}}, "profile": {"type": "object", "required": ["accepted", "meta_values", "overrides"], "additionalProperties": false, "properties": {"accepted": {"type": "boolean"}, "meta_values": {"$ref": "#/$defs/value_map"}, "overrides": {"$ref": "#/$defs/value_map"}}}}
}
