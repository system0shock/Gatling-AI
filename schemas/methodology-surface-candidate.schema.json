{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merged bounded discovery surface candidate",
  "type": "object", "additionalProperties": false,
  "required": ["version", "candidate_id", "snapshot_id", "entities", "review_groups", "conflicts", "possible_duplicates", "repository_diagnostics", "warnings"],
  "properties": {"version": {"const": 1}, "candidate_id": {"$ref": "#/$defs/nonblank"}, "snapshot_id": {"$ref": "#/$defs/sha256"}, "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "review_groups": {"type": "array", "items": {"$ref": "#/$defs/review_group"}}, "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}, "possible_duplicates": {"type": "array", "items": {"$ref": "#/$defs/duplicate"}}, "repository_diagnostics": {"type": "array", "items": {"$ref": "#/$defs/repository_diagnostic"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}},
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_posix_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^/]+(?:/[^/]+)*$"}, "scalar": {"type": ["string", "number", "boolean", "null"]}, "attribute_value": {"oneOf": [{"$ref": "#/$defs/scalar"}, {"type": "array", "items": {"$ref": "#/$defs/scalar"}}]}, "attributes": {"type": "object", "additionalProperties": false, "patternProperties": {"^[A-Za-z][A-Za-z0-9_.-]*$": {"$ref": "#/$defs/attribute_value"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["repo_id", "revision", "path", "pointer", "selection_reason", "sha256"], "properties": {"repo_id": {"$ref": "#/$defs/nonblank"}, "revision": {"$ref": "#/$defs/nonblank"}, "path": {"$ref": "#/$defs/relative_posix_path"}, "pointer": {"$ref": "#/$defs/nonblank"}, "selection_reason": {"$ref": "#/$defs/nonblank"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "service_identity": {"type": "object", "additionalProperties": false, "required": ["value", "basis"], "properties": {"value": {"$ref": "#/$defs/nonblank"}, "basis": {"enum": ["contract", "manifest", "metadata", "unknown"]}}},
    "entity": {"type": "object", "additionalProperties": false, "required": ["entity_type", "canonical_key", "display_name", "service_identity", "attributes", "sources", "confidence"], "properties": {"entity_type": {"enum": ["component", "interface", "integration", "flow"]}, "canonical_key": {"$ref": "#/$defs/nonblank"}, "display_name": {"$ref": "#/$defs/nonblank"}, "service_identity": {"$ref": "#/$defs/service_identity"}, "attributes": {"$ref": "#/$defs/attributes"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "confidence": {"enum": ["confirmed", "candidate"]}}},
    "review_group": {"type": "object", "additionalProperties": false, "required": ["group_id", "display_name", "entity_keys"], "properties": {"group_id": {"$ref": "#/$defs/nonblank"}, "display_name": {"$ref": "#/$defs/nonblank"}, "entity_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "canonical_key", "attribute", "values"], "properties": {"conflict_id": {"$ref": "#/$defs/nonblank"}, "canonical_key": {"$ref": "#/$defs/nonblank"}, "attribute": {"$ref": "#/$defs/nonblank"}, "values": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["value", "sources"], "properties": {"value": {"$ref": "#/$defs/attribute_value"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}}}}},
    "duplicate": {"type": "object", "additionalProperties": false, "required": ["duplicate_id", "protocol_signature", "entity_keys"], "properties": {"duplicate_id": {"$ref": "#/$defs/nonblank"}, "protocol_signature": {"$ref": "#/$defs/nonblank"}, "entity_keys": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/nonblank"}, "message": {"$ref": "#/$defs/nonblank"}, "path": {"$ref": "#/$defs/relative_posix_path"}}},
    "repository_diagnostic": {"type": "object", "additionalProperties": false, "required": ["repo_id", "diagnostics"], "properties": {"repo_id": {"$ref": "#/$defs/nonblank"}, "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}}}
  }
}
