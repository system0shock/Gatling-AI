{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gatling-AI workspace manifest v2",
  "type": "object",
  "required": ["version", "system", "workspace_root", "load_test_module", "repositories", "write_policy"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "system": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$"},
    "workspace_root": {"type": "string", "minLength": 1},
    "load_test_module": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "path": {"type": "string", "minLength": 1},
          "roles": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
            "uniqueItems": true
          },
          "service_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "required": {"type": "boolean"},
          "inspect": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "exclude": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "authoritative_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "write_policy": {
      "type": "object",
      "required": ["allowed_modules", "sut_modules"],
      "additionalProperties": false,
      "properties": {
        "allowed_modules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sut_modules": {"const": "read-only"}
      }
    }
  }
}
