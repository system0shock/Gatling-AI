<JSR223PreProcessor testclass="JSR223PreProcessor" testname="take token" enabled="true">
  <stringProp name="script">def t = props.get("sharedToken")
def sig = SignerUtil.hmac(t, vars.get("body"))
vars.put("authSig", sig)</stringProp>
  <stringProp name="scriptLanguage">groovy</stringProp>
</JSR223PreProcessor>
<hashTree>

</hashTree>
