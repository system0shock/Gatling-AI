  <collectionProp name="Asserion.test_strings">
  <stringProp name="s0">200</stringProp>
  </collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion>
<hashTree>

</hashTree>
<JSR223PostProcessor testclass="JSR223PostProcessor" testname="share token" enabled="true">
  <stringProp name="script">props.put("sharedToken", vars.get("token"))</stringProp>
  <stringProp name="scriptLanguage">groovy</stringProp>
</JSR223PostProcessor>
<hashTree>

</hashTree>
</hashTree>
</hashTree>
<TransactionController testclass="TransactionController" testname="kafka publish" enabled="true">
  <boolProp name="TransactionController.parent">true</boolProp>
</TransactionController>
<hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="produce event" enabled="true">
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <stringProp name="HTTPSampler.path">/kafka/produce?topic=orders</stringProp>
  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
    <collectionProp name="Arguments.arguments">
      <elementProp name="" elementType="HTTPArgument">
        <stringProp name="Argument.value">{"event":"order-created","id":"${productId}"}</stringProp>
      </elementProp>
    </collectionProp>
  </elementProp>
</HTTPSamplerProxy>
<hashTree>
<ResponseAssertion testclass="ResponseAssertion" testname="status 202" enabled="true">
  <collectionProp name="Asserion.test_strings">
  <stringProp name="s0">200</stringProp>
  </collectionProp>
  <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
  <intProp name="Assertion.test_type">8</intProp>
</ResponseAssertion>
<hashTree>

</hashTree>
</hashTree>
</hashTree>
</hashTree>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stage B - consumer" enabled="true">
