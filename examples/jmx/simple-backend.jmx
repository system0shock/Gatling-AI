<kg.apc.jmeter.threads.UltimateThreadGroup guiclass="UltimateThreadGroupGui" testclass="kg.apc.jmeter.threads.UltimateThreadGroup" testname="Backend load" enabled="true">
  <collectionProp name="ultimatethreadgroupdata">
    <collectionProp name="row">
      <stringProp name="c0">50</stringProp>
      <stringProp name="c1">0</stringProp>
      <stringProp name="c2">120</stringProp>
      <stringProp name="c3">600</stringProp>
      <stringProp name="c4">60</stringProp>
    </collectionProp>
  </collectionProp>
</kg.apc.jmeter.threads.UltimateThreadGroup>
