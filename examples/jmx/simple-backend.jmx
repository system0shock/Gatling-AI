<TransactionController testclass="TransactionController" testname="catalog search" enabled="true">
  <boolProp name="TransactionController.parent">true</boolProp>
</TransactionController>
<hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="search" enabled="true">
  <stringProp name="HTTPSampler.method">GET</stringProp>
  <stringProp name="HTTPSampler.path">/search?q=${term}</stringProp>
</HTTPSamplerProxy>
<hashTree>
<RegexExtractor testclass="RegexExtractor" testname="get csrf" enabled="true">
  <stringProp name="RegexExtractor.refname">csrf</stringProp>
  <stringProp name="RegexExtractor.regex">name="csrf" value="(.+?)"</stringProp>
  <stringProp name="RegexExtractor.template">$1$</stringProp>
  <stringProp name="RegexExtractor.match_number">1</stringProp>
  <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
</RegexExtractor>
<hashTree>

</hashTree>
<ResponseAssertion testclass="ResponseAssertion" testname="status 200" enabled="true">
