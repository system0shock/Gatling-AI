# Build outputs
target/
build/
out/

# Gatling reports
**/target/gatling/
**/build/reports/gatling/

# Local runtime artifacts
.worktrees/
.superpowers/
.idea/
.vscode/
__pycache__/
*.log
*.tmp
*.orig
# Qwen Code per-host config / bridge (never committed)
.qwen/

# Bounded discovery local artifacts
**/.methodology-cache/
**/methodology-runs/*/discovery/*/document-inputs/
**/methodology-runs/*/discovery/*/extractor-results/*.candidate.json

# Secrets and local environment
.env
.env.*
!.env.example
secrets/

# Quality gate generated reports
quality-gate-report.json
quality-gate-report.md

# Windows-local authoring test residue: static test roots can remain locked after a run.
tools/methodology_authoring/.test-fixtures/

# Windows-local methodology quality-gate test residue: generated test fixtures.
tools/methodology_quality_gate/.test-fixtures/

# Windows-local methodology refresh test residue.
tools/methodology_refresh/.test-fixtures/

# Windows-local methodology publish guard test residue.
tools/methodology_publish/.test-fixtures/

# Generated Maven projects (build outputs, never tracked)
examples/generated/
e2e/project/
scenarios/**/src/
scenarios/**/pom.xml
